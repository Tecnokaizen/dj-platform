generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EditorialStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
  RETIRED
  UNKNOWN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  READER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum GenreRole {
  PRIMARY
  SECONDARY
  INFLUENCE
  HISTORICAL
}

enum AliasType {
  ALTERNATIVE
  FORMER
  LEGAL
  COLLECTIVE
  OTHER
}

enum RankingType {
  EDITORIAL
  POPULARITY
  GENRE
  COUNTRY
  EMERGING
  HISTORICAL
}

enum SessionType {
  DJ_SET
  LIVE_SET
  RADIO_SHOW
  PODCAST
  MIX
  OTHER
}

enum ExternalPlatform {
  SPOTIFY
  YOUTUBE
  YOUTUBE_MUSIC
  SOUNDCLOUD
  APPLE_MUSIC
  BEATPORT
  DISCOGS
  MUSICBRAINZ
  BANDCAMP
  MIXCLOUD
  OTHER
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  X
  TIKTOK
  THREADS
  TWITCH
  WEBSITE
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  PENDING
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum SourceType {
  OFFICIAL_WEBSITE
  INTERVIEW
  PRESS
  DATABASE
  SOCIAL
  FESTIVAL
  LABEL
  STREAMING
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  PARTIALLY_VERIFIED
  VERIFIED
  REJECTED
}

enum ArticleType {
  NEWS
  GUIDE
  LIST
  BIOGRAPHY
  INTERVIEW
  REVIEW
  FEATURE
  EVERGREEN
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
  FAILED
}

enum AiValidationStatus {
  PENDING
  VALID
  INVALID
  REVIEWED
  REJECTED
}

enum SimilarityType {
  EDITORIAL
  GENRE
  STYLE
  AUDIENCE
  COLLABORATION
  AI_SUGGESTED
}

enum RelationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrackCreditType {
  PRIMARY_ARTIST
  FEATURED_ARTIST
  REMIXER
  PRODUCER
  COMPOSER
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  status         UserStatus   @default(INVITED)
  role           UserRole     @default(READER)
  securityVersion Int         @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  authoredArticles Article[]     @relation("ArticleAuthor")
  reviewedAi      AiGeneration[] @relation("AiReviewer")
  favorites       Favorite[]
  auditEvents     AuditEvent[]   @relation("AuditActor")
  importJobs      ImportJob[]    @relation("ImportCreator")

  @@index([status])
  @@index([role])
  @@map("users")
}

model Country {
  id        String   @id @default(cuid())
  isoCode   String   @unique @db.VarChar(2)
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities    City[]
  djs       Dj[]
  festivals Festival[]
  labels    Label[]

  @@index([name])
  @@map("countries")
}

model City {
  id        String   @id @default(cuid())
  countryId String
  name      String
  slug      String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  djs       Dj[]
  festivals Festival[]

  @@unique([countryId, slug])
  @@index([countryId, name])
  @@map("cities")
}

model Dj {
  id              String          @id @default(cuid())
  slug            String          @unique
  displayName     String
  normalizedName  String
  realName        String?
  shortBio        String?         @db.Text
  longBio         String?         @db.Text
  countryId       String?
  cityId          String?
  activeFrom      Int?
  activeTo        Int?
  activityStatus  ActivityStatus  @default(UNKNOWN)
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  reviewedAt      DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  country            Country?              @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city               City?                 @relation(fields: [cityId], references: [id], onDelete: SetNull)
  aliases            DjAlias[]
  genres             DjGenre[]
  appearances        FestivalAppearance[]
  rankingEntries     RankingEntry[]
  sessions           Session[]
  socialProfiles     SocialProfile[]
  externalProfiles   ExternalProfile[]
  media               DjMedia[]
  sources             DjSource[]
  articles            ArticleDj[]
  favorites           Favorite[]
  trackCredits        TrackCredit[]
  labels              DjLabel[]
  similaritiesFrom    DjSimilarity[]       @relation("SimilaritySource")
  similaritiesTo      DjSimilarity[]       @relation("SimilarityTarget")

  @@index([normalizedName])
  @@index([editorialStatus, publishedAt])
  @@index([countryId])
  @@index([cityId])
  @@index([deletedAt])
  @@map("djs")
}

model DjAlias {
  id             String    @id @default(cuid())
  djId           String
  name           String
  normalizedName String
  aliasType      AliasType @default(ALTERNATIVE)
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dj Dj @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@unique([djId, normalizedName])
  @@index([normalizedName])
  @@map("dj_aliases")
}

model Genre {
  id              String          @id @default(cuid())
  parentId        String?
  slug            String          @unique
  name            String
  normalizedName  String
  description     String?         @db.Text
  history         String?         @db.Text
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  parent          Genre?          @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Genre[]         @relation("GenreHierarchy")
  djs             DjGenre[]
  articles        ArticleGenre[]
  relatedFrom     GenreRelation[] @relation("GenreRelationSource")
  relatedTo       GenreRelation[] @relation("GenreRelationTarget")

  @@index([normalizedName])
  @@index([parentId])
  @@index([editorialStatus, publishedAt])
  @@map("genres")
}

model GenreRelation {
  id            String   @id @default(cuid())
  sourceGenreId String
  targetGenreId String
  weight        Int?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sourceGenre Genre @relation("GenreRelationSource", fields: [sourceGenreId], references: [id], onDelete: Cascade)
  targetGenre Genre @relation("GenreRelationTarget", fields: [targetGenreId], references: [id], onDelete: Cascade)

  @@unique([sourceGenreId, targetGenreId])
  @@index([targetGenreId])
  @@map("genre_relations")
}

model DjGenre {
  id             String     @id @default(cuid())
  djId           String
  genreId        String
  sourceId       String?
  role           GenreRole  @default(SECONDARY)
  weight         Int?
  confidence     Decimal?   @db.Decimal(5, 4)
  editorialNotes String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  dj     Dj      @relation(fields: [djId], references: [id], onDelete: Cascade)
  genre  Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([djId, genreId])
  @@index([genreId, role])
  @@index([sourceId])
  @@map("dj_genres")
}

model Festival {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  normalizedName  String
  description     String?         @db.Text
  countryId       String?
  cityId          String?
  officialUrl     String?
  foundedYear     Int?
  activityStatus  ActivityStatus  @default(UNKNOWN)
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  country  Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city     City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  editions FestivalEdition[]

  @@index([normalizedName])
  @@index([countryId])
  @@index([cityId])
  @@index([editorialStatus, publishedAt])
  @@map("festivals")
}

model FestivalEdition {
  id          String   @id @default(cuid())
  festivalId  String
  name        String
  year        Int
  startsAt    DateTime?
  endsAt      DateTime?
  officialUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  festival   Festival             @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  appearances FestivalAppearance[]

  @@unique([festivalId, year])
  @@index([year])
  @@map("festival_editions")
}

model FestivalAppearance {
  id                String    @id @default(cuid())
  festivalEditionId String
  djId              String
  sourceId          String?
  stage             String?
  performanceDate   DateTime?
  billingPosition   Int?
  isHeadliner       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  festivalEdition FestivalEdition @relation(fields: [festivalEditionId], references: [id], onDelete: Cascade)
  dj              Dj              @relation(fields: [djId], references: [id], onDelete: Cascade)
  source          Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([festivalEditionId, djId, performanceDate])
  @@index([djId])
  @@index([sourceId])
  @@map("festival_appearances")
}

model Ranking {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  description     String?         @db.Text
  rankingType     RankingType
  methodology     String?         @db.Text
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  editions RankingEdition[]

  @@index([rankingType])
  @@index([editorialStatus, publishedAt])
  @@map("rankings")
}

model RankingEdition {
  id          String    @id @default(cuid())
  rankingId   String
  label       String
  year        Int?
  periodStart DateTime?
  periodEnd   DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ranking Ranking        @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  entries RankingEntry[]

  @@unique([rankingId, label])
  @@index([year])
  @@map("ranking_editions")
}

model RankingEntry {
  id                String   @id @default(cuid())
  rankingEditionId  String
  djId              String
  position          Int
  previousPosition  Int?
  score             Decimal? @db.Decimal(10, 4)
  editorialNote     String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rankingEdition RankingEdition @relation(fields: [rankingEditionId], references: [id], onDelete: Cascade)
  dj             Dj             @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@unique([rankingEditionId, position])
  @@unique([rankingEditionId, djId])
  @@index([djId])
  @@map("ranking_entries")
}

model Session {
  id              String          @id @default(cuid())
  djId            String
  slug            String          @unique
  title           String
  sessionType     SessionType
  platform        ExternalPlatform
  externalUrl     String
  performedAt     DateTime?
  externalPublishedAt DateTime?
  durationSeconds Int?
  description     String?         @db.Text
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  dj Dj @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@index([djId, editorialStatus])
  @@index([platform])
  @@map("sessions")
}

model Article {
  id              String          @id @default(cuid())
  authorId        String?
  slug            String          @unique
  title           String
  excerpt         String?         @db.Text
  body            String          @db.Text
  articleType     ArticleType
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  reviewedAt      DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  author User?          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  djs    ArticleDj[]
  genres ArticleGenre[]

  @@index([authorId])
  @@index([articleType])
  @@index([editorialStatus, publishedAt])
  @@map("articles")
}

model ArticleDj {
  articleId String
  djId      String
  position  Int?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  dj      Dj      @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@id([articleId, djId])
  @@index([djId])
  @@map("article_djs")
}

model ArticleGenre {
  articleId String
  genreId   String
  position  Int?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([articleId, genreId])
  @@index([genreId])
  @@map("article_genres")
}

model MediaAsset {
  id         String      @id @default(cuid())
  storageKey String      @unique
  mediaType  MediaType
  mimeType   String
  width      Int?
  height     Int?
  fileSize   Int
  altText    String?
  credit     String?
  sourceUrl  String?
  license    String?
  status     MediaStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  djs DjMedia[]

  @@index([mediaType, status])
  @@map("media_assets")
}

model DjMedia {
  djId         String
  mediaAssetId String
  role         String
  position     Int?
  createdAt    DateTime @default(now())

  dj         Dj         @relation(fields: [djId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([djId, mediaAssetId, role])
  @@index([mediaAssetId])
  @@map("dj_media")
}

model SocialProfile {
  id         String         @id @default(cuid())
  djId       String
  platform   SocialPlatform
  handle     String?
  url        String
  verifiedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  dj Dj @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@unique([djId, platform, url])
  @@index([platform])
  @@map("social_profiles")
}

model ExternalProfile {
  id         String           @id @default(cuid())
  djId       String
  provider   ExternalPlatform
  externalId String?
  url        String
  metadata   Json?
  verifiedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  dj Dj @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@unique([djId, provider, url])
  @@unique([provider, externalId])
  @@index([provider])
  @@map("external_profiles")
}

model Source {
  id                 String             @id @default(cuid())
  url                String             @unique
  title              String?
  publisher          String?
  sourceType         SourceType
  accessedAt         DateTime
  verificationStatus VerificationStatus @default(UNVERIFIED)
  notes              String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  djGenres            DjGenre[]
  festivalAppearances FestivalAppearance[]
  djs                 DjSource[]

  @@index([sourceType])
  @@index([verificationStatus])
  @@map("sources")
}

model DjSource {
  djId      String
  sourceId  String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  dj     Dj     @relation(fields: [djId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([djId, sourceId])
  @@index([sourceId])
  @@map("dj_sources")
}

model Favorite {
  userId    String
  djId      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dj   Dj   @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@id([userId, djId])
  @@index([djId])
  @@map("favorites")
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipHash     String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model ImportJob {
  id             String       @id @default(cuid())
  createdById    String?
  originalName   String
  storageKey     String?
  mimeType       String?
  checksum       String?
  status         ImportStatus @default(PENDING)
  totalRows      Int          @default(0)
  validRows      Int          @default(0)
  invalidRows    Int          @default(0)
  duplicateRows  Int          @default(0)
  importedRows   Int          @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy User?       @relation("ImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rows      ImportRow[]

  @@index([createdById])
  @@index([status, createdAt])
  @@map("import_jobs")
}

model ImportRow {
  id             String          @id @default(cuid())
  importJobId    String
  rowNumber      Int
  status         ImportRowStatus @default(PENDING)
  rawData        Json
  normalizedData Json?
  validationErrors Json?
  entityType     String?
  entityId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([status])
  @@map("import_rows")
}

model AiGeneration {
  id               String             @id @default(cuid())
  reviewedById     String?
  provider         String
  model            String
  promptVersion    String
  taskType         String
  inputHash        String
  output           Json
  validationStatus AiValidationStatus @default(PENDING)
  tokenUsage       Json?
  estimatedCost    Decimal?           @db.Decimal(12, 6)
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())

  reviewedBy User? @relation("AiReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([taskType, promptVersion])
  @@index([inputHash])
  @@index([validationStatus])
  @@map("ai_generations")
}

model DjSimilarity {
  id             String               @id @default(cuid())
  sourceDjId     String
  targetDjId     String
  similarityType SimilarityType
  score          Decimal?             @db.Decimal(5, 4)
  explanation    String?              @db.Text
  generatedBy    String?
  reviewStatus   RelationReviewStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  sourceDj Dj @relation("SimilaritySource", fields: [sourceDjId], references: [id], onDelete: Cascade)
  targetDj Dj @relation("SimilarityTarget", fields: [targetDjId], references: [id], onDelete: Cascade)

  @@unique([sourceDjId, targetDjId, similarityType])
  @@index([targetDjId])
  @@index([reviewStatus])
  @@map("dj_similarities")
}

model Track {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  normalizedTitle String
  releaseDate     DateTime?
  durationSeconds Int?
  isrc            String?         @unique
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  credits TrackCredit[]

  @@index([normalizedTitle])
  @@index([editorialStatus, publishedAt])
  @@map("tracks")
}

model TrackCredit {
  trackId     String
  djId        String
  creditType  TrackCreditType
  position    Int             @default(0)
  displayName String?
  createdAt   DateTime        @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  dj    Dj    @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@id([trackId, djId, creditType])
  @@index([djId])
  @@map("track_credits")
}

model Label {
  id              String          @id @default(cuid())
  countryId       String?
  slug            String          @unique
  name            String
  normalizedName  String
  description     String?         @db.Text
  officialUrl     String?
  editorialStatus EditorialStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  djs     DjLabel[]

  @@index([normalizedName])
  @@index([countryId])
  @@map("labels")
}

model DjLabel {
  djId      String
  labelId   String
  role      String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime @default(now())

  dj    Dj    @relation(fields: [djId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([djId, labelId])
  @@index([labelId])
  @@map("dj_labels")
}
