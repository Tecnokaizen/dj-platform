generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum ArtistType {
  PERSON
  GROUP
  PROJECT
  ORCHESTRA
  COLLECTIVE
  UNKNOWN
}

enum ArtistRole {
  PRIMARY
  FEATURED
  REMIXER
  PRODUCER
  COMPOSER
  VOCALIST
  DJ_MIXER
  OTHER
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
  COMPILATION
  DJ_MIX
  SOUNDTRACK
  LIVE
  OTHER
}

enum AssignmentMethod {
  SOURCE
  AI
  AUDIO_ANALYSIS
  MANUAL
  CONSENSUS
}

enum SourceType {
  API
  WEB
  FILE
  AI
  MANUAL
  INTERNAL
}

enum EntityType {
  ARTIST
  TRACK
  RELEASE
  LABEL
  GENRE
  PLAYLIST
  DJ_SET
}

enum AvailabilityStatus {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
  REGION_RESTRICTED
  REMOVED
  PRIVATE
}

enum ExtractionMethod {
  API_RESPONSE
  HTML_PARSER
  STRUCTURED_DATA
  METADATA
  AUDIO_ANALYSIS
  AI_EXTRACTION
  AI_INFERENCE
  MANUAL
  DERIVED
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLED
}

enum IngestionJobType {
  TRACKLIST_URL
  TRACKLIST_TEXT
  PLAYLIST_URL
  CHANNEL_SCAN
  SOURCE_SYNC
  FILE_IMPORT
  MANUAL_BATCH
}

enum IngestionItemStatus {
  PENDING
  PARSED
  MATCHED
  CREATED
  NEEDS_REVIEW
  SKIPPED
  FAILED
}

enum EnrichmentJobType {
  METADATA_ENRICHMENT
  TRACK_MATCHING
  GENRE_CLASSIFICATION
  BPM_ANALYSIS
  KEY_ANALYSIS
  MOOD_CLASSIFICATION
  ENERGY_CLASSIFICATION
  ARTIST_RESOLUTION
  DUPLICATE_DETECTION
  SOURCE_DISCOVERY
  PLAYLIST_ANALYSIS
  TRANSITION_RECOMMENDATION
}

enum UserTrackStatus {
  LIBRARY
  WISHLIST
  ARCHIVED
  REJECTED
}

enum PlaylistType {
  MANUAL
  IMPORTED
  SMART
  AI_GENERATED
  CRATE
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("membership_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

model Profile {
  id                  String           @id @db.Uuid
  username            String?          @unique @db.VarChar(50)
  authEmailNormalized String?          @unique(map: "profiles_auth_email_normalized_unique") @map("auth_email_normalized") @db.VarChar(320)
  displayName         String?          @map("display_name") @db.VarChar(120)
  djName              String?          @map("dj_name") @db.VarChar(120)
  avatarUrl           String?          @map("avatar_url")
  bio                 String?          @db.Text
  countryCode         String?          @map("country_code") @db.Char(2)
  preferredLanguage   String           @default("es") @map("preferred_language") @db.VarChar(10)
  experienceLevel     ExperienceLevel? @map("experience_level")
  isAdmin             Boolean          @default(false) @map("is_admin")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships              OrganizationMembership[]
  acceptedInvitations      OrganizationInvitation[] @relation("InvitationAcceptedByProfile")
  djStudioProfile          DjStudioProfile?
  addedLibraryItems         LibraryItem[]            @relation("LibraryItemAddedBy")
  addedPlaylistItems        PlaylistItem[]           @relation("PlaylistItemAddedBy")
  legacyUserTracks          LegacyUserTrack[]
  legacyProfileTags         LegacyProfileTag[]
  legacyProfilePlaylists    LegacyProfilePlaylist[]
  ingestionJobs             IngestionJob[]           @relation("IngestionRequestedBy")
  legacyPlaylistTracksAdded LegacyPlaylistTrack[]    @relation("LegacyPlaylistTrackAddedBy")

  @@map("profiles")
}

model DjStudioProfile {
  profileId       String           @id @map("profile_id") @db.Uuid
  stageName       String?          @map("stage_name") @db.VarChar(120)
  experienceLevel ExperienceLevel? @map("experience_level")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("dj_studio_profiles")
}

model LibraryItem {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  trackId          String          @map("track_id") @db.Uuid
  addedByProfileId String?         @map("added_by_profile_id") @db.Uuid
  status           UserTrackStatus @default(LIBRARY)
  rating           Int?            @db.SmallInt
  energy           Int?            @db.SmallInt
  familiarity      Int?            @db.SmallInt
  notes            String?         @db.Text
  customBpm        Decimal?        @map("custom_bpm") @db.Decimal(7, 3)
  customKey        String?         @map("custom_key") @db.VarChar(20)
  isFavorite       Boolean         @default(false) @map("is_favorite")
  playCount        Int             @default(0) @map("play_count")
  dateAdded        DateTime        @default(now()) @map("date_added") @db.Timestamptz(6)
  lastPlayedAt     DateTime?       @map("last_played_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  track         Track             @relation(fields: [trackId], references: [id], onDelete: Restrict)
  addedBy       Profile?          @relation("LibraryItemAddedBy", fields: [addedByProfileId], references: [id], onDelete: SetNull)
  tags          LibraryItemTag[]
  playlistItems PlaylistItem[]

  @@unique([organizationId, trackId], map: "library_items_organization_track_unique")
  @@unique([organizationId, id], map: "library_items_organization_id_unique")
  @@index([organizationId, dateAdded(sort: Desc)], map: "library_items_organization_date_added_idx")
  @@index([organizationId, status], map: "library_items_organization_status_idx")
  @@index([organizationId, isFavorite], map: "library_items_organization_is_favorite_idx")
  @@index([trackId], map: "library_items_track_idx")
  @@map("library_items")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  normalizedName String   @map("normalized_name") @db.VarChar(80)
  color          String?  @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  libraryItems LibraryItemTag[]

  @@unique([organizationId, normalizedName], map: "tags_organization_normalized_name_unique")
  @@unique([organizationId, id], map: "tags_organization_id_unique")
  @@index([organizationId], map: "tags_organization_idx")
  @@map("tags")
}

model LibraryItemTag {
  organizationId String @map("organization_id") @db.Uuid
  libraryItemId  String @map("library_item_id") @db.Uuid
  tagId          String @map("tag_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  libraryItem  LibraryItem  @relation(fields: [organizationId, libraryItemId], references: [organizationId, id], onDelete: Cascade)
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([libraryItemId, tagId], map: "library_item_tags_pkey")
  @@index([organizationId], map: "library_item_tags_organization_idx")
  @@index([tagId], map: "library_item_tags_tag_idx")
  @@map("library_item_tags")
}

// TENANT INTEGRITY (M4): composite FKs enforce
// library_item_tags / playlist_items organizationId matches parent rows.
// Parent UNIQUE (organizationId, id) on LibraryItem, Tag, and Playlist required.

model Playlist {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(255)
  slug           String?      @db.VarChar(255)
  description    String?      @db.Text
  playlistType   PlaylistType @map("playlist_type")
  visibility     Visibility   @default(PRIVATE)
  artworkUrl     String?      @map("artwork_url")
  sourceUrl      String?      @map("source_url")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        PlaylistItem[]

  @@unique([organizationId, slug], map: "playlists_organization_slug_unique")
  @@unique([organizationId, id], map: "playlists_organization_id_unique")
  @@index([organizationId, updatedAt(sort: Desc)], map: "playlists_organization_updated_at_idx")
  @@index([visibility], map: "playlists_visibility_idx")
  @@index([playlistType], map: "playlists_playlist_type_idx")
  @@map("playlists")
}

model PlaylistItem {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  playlistId        String   @map("playlist_id") @db.Uuid
  libraryItemId     String   @map("library_item_id") @db.Uuid
  position          Int
  addedByProfileId  String?  @map("added_by_profile_id") @db.Uuid
  notes             String?  @db.Text
  transitionNotes   String?  @map("transition_notes") @db.Text
  sourceTimestampMs Int?     @map("source_timestamp_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playlist     Playlist     @relation(fields: [organizationId, playlistId], references: [organizationId, id], onDelete: Cascade)
  libraryItem  LibraryItem  @relation(fields: [organizationId, libraryItemId], references: [organizationId, id], onDelete: Restrict)
  addedBy      Profile?     @relation("PlaylistItemAddedBy", fields: [addedByProfileId], references: [id], onDelete: SetNull)

  // Repeated LibraryItem in one Playlist is allowed (no unique on libraryItemId).
  @@unique([playlistId, position], map: "playlist_items_playlist_position_unique")
  @@index([organizationId], map: "playlist_items_organization_idx")
  @@index([playlistId, position], map: "playlist_items_playlist_position_idx")
  @@index([libraryItemId], map: "playlist_items_library_item_idx")
  @@index([addedByProfileId], map: "playlist_items_added_by_idx")
  @@map("playlist_items")
}

model Organization {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  slug       String             @unique
  status     OrganizationStatus @default(ACTIVE)
  logoUrl    String?            @map("logo_url")
  locale     String             @default("es")
  timezone   String             @default("UTC")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime?          @map("archived_at") @db.Timestamptz(6)

  memberships      OrganizationMembership[]
  invitations      OrganizationInvitation[]
  libraryItems     LibraryItem[]
  tags             Tag[]
  libraryItemTags  LibraryItemTag[]
  playlists        Playlist[]
  playlistItems    PlaylistItem[]

  @@index([status])
  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships        OrganizationMembership[]
  invitations        OrganizationInvitation[]
  permissionMappings RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique(map: "permissions_key_unique") @db.VarChar(150)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roleMappings RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId], map: "role_permissions_role_permission_unique")
  @@index([permissionId], map: "role_permissions_permission_idx")
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  profileId      String           @map("profile_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  suspendedAt    DateTime?        @map("suspended_at") @db.Timestamptz(6)
  removedAt      DateTime?        @map("removed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  invitationsSent OrganizationInvitation[] @relation("InvitationInviterMembership")

  @@unique([organizationId, profileId], map: "organization_memberships_organization_profile_unique")
  @@index([organizationId, status], map: "organization_memberships_organization_status_idx")
  @@index([profileId, status], map: "organization_memberships_profile_status_idx")
  @@index([roleId], map: "organization_memberships_role_idx")
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  recipientEmail        String           @map("recipient_email") @db.VarChar(320)
  normalizedEmail       String           @map("normalized_email") @db.VarChar(320)
  roleId                String           @map("role_id") @db.Uuid
  status                InvitationStatus @default(PENDING)
  tokenHash             String           @unique(map: "organization_invitations_token_hash_unique") @map("token_hash") @db.VarChar(255)
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedByMembershipId String           @map("invited_by_membership_id") @db.Uuid
  acceptedByProfileId   String?          @map("accepted_by_profile_id") @db.Uuid
  acceptedAt            DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt             DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByMembership OrganizationMembership @relation("InvitationInviterMembership", fields: [invitedByMembershipId], references: [id], onDelete: Restrict)
  acceptedByProfile   Profile?               @relation("InvitationAcceptedByProfile", fields: [acceptedByProfileId], references: [id], onDelete: Restrict)

  @@index([organizationId, status], map: "organization_invitations_organization_status_idx")
  @@index([status, expiresAt], map: "organization_invitations_status_expires_idx")
  @@map("organization_invitations")
}

model Artist {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(255)
  normalizedName      String     @map("normalized_name") @db.VarChar(255)
  slug                String     @unique @db.VarChar(255)
  artistType          ArtistType @default(PERSON) @map("artist_type")
  countryCode         String?    @map("country_code") @db.Char(2)
  biography           String?    @db.Text
  imageUrl            String?    @map("image_url")
  canonicalConfidence Decimal?   @map("canonical_confidence") @db.Decimal(5, 4)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  trackArtists TrackArtist[]

  @@index([normalizedName])
  @@map("artists")
}

model Track {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String    @db.VarChar(500)
  normalizedTitle     String    @map("normalized_title") @db.VarChar(500)
  version             String?   @db.VarChar(255)
  durationMs          Int?      @map("duration_ms")
  bpm                 Decimal?  @db.Decimal(7, 3)
  musicalKey          String?   @map("musical_key") @db.VarChar(20)
  camelotKey          String?   @map("camelot_key") @db.VarChar(4)
  isrc                String?   @db.VarChar(20)
  releaseDate         DateTime? @map("release_date") @db.Date
  explicit            Boolean?
  artworkUrl          String?   @map("artwork_url")
  canonicalConfidence Decimal?  @map("canonical_confidence") @db.Decimal(5, 4)
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  artists              TrackArtist[]
  genres               TrackGenre[]
  releases             ReleaseTrack[]
  libraryItems         LibraryItem[]
  legacyUserTracks     LegacyUserTrack[]
  legacyPlaylistTracks LegacyPlaylistTrack[]
  ingestionItems       IngestionItem[]

  @@index([normalizedTitle])
  @@index([isrc])
  @@index([bpm])
  @@index([camelotKey])
  @@map("tracks")
}

model TrackArtist {
  trackId      String     @map("track_id") @db.Uuid
  artistId     String     @map("artist_id") @db.Uuid
  role         ArtistRole
  position     Int        @default(0) @db.SmallInt
  creditedName String?    @map("credited_name") @db.VarChar(255)

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([trackId, artistId, role])
  @@index([artistId])
  @@index([trackId, position])
  @@map("track_artists")
}

model Genre {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @map("normalized_name") @db.VarChar(120)
  slug           String   @unique @db.VarChar(150)
  parentId       String?  @map("parent_id") @db.Uuid
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Genre?       @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Genre[]      @relation("GenreHierarchy")
  tracks   TrackGenre[]

  @@index([normalizedName])
  @@index([parentId])
  @@map("genres")
}

model TrackGenre {
  trackId          String           @map("track_id") @db.Uuid
  genreId          String           @map("genre_id") @db.Uuid
  isPrimary        Boolean          @default(false) @map("is_primary")
  confidence       Decimal?         @db.Decimal(5, 4)
  assignmentMethod AssignmentMethod @map("assignment_method")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([trackId, genreId])
  @@index([genreId])
  @@index([trackId, isPrimary])
  @@map("track_genres")
}

model Label {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  normalizedName String   @map("normalized_name") @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  countryCode    String?  @map("country_code") @db.Char(2)
  websiteUrl     String?  @map("website_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  releases Release[]

  @@index([normalizedName])
  @@map("labels")
}

model Release {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(500)
  normalizedTitle String      @map("normalized_title") @db.VarChar(500)
  releaseType     ReleaseType @map("release_type")
  labelId         String?     @map("label_id") @db.Uuid
  catalogNumber   String?     @map("catalog_number") @db.VarChar(100)
  releaseDate     DateTime?   @map("release_date") @db.Date
  artworkUrl      String?     @map("artwork_url")
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  label  Label?         @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tracks ReleaseTrack[]

  @@index([normalizedTitle])
  @@index([labelId])
  @@index([releaseDate])
  @@index([catalogNumber])
  @@map("releases")
}

model ReleaseTrack {
  releaseId   String @map("release_id") @db.Uuid
  trackId     String @map("track_id") @db.Uuid
  discNumber  Int    @default(1) @map("disc_number") @db.SmallInt
  trackNumber Int?   @map("track_number") @db.SmallInt
  position    Int

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([releaseId, position])
  @@unique([releaseId, discNumber, trackNumber])
  @@index([trackId])
  @@map("release_tracks")
}

model DataSource {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(80)
  name        String     @db.VarChar(160)
  sourceType  SourceType @map("source_type")
  baseUrl     String?    @map("base_url")
  isActive    Boolean    @default(true) @map("is_active")
  trustWeight Decimal    @default(0.5000) @map("trust_weight") @db.Decimal(5, 4)
  config      Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalEntities ExternalEntity[]
  snapshots        SourceSnapshot[]
  facts            EntityFact[]
  ingestionJobs    IngestionJob[]

  @@map("data_sources")
}

model ExternalEntity {
  id                 String             @id @default(uuid()) @db.Uuid
  sourceId           String             @map("source_id") @db.Uuid
  entityType         EntityType         @map("entity_type")
  entityId           String             @map("entity_id") @db.Uuid
  externalId         String?            @map("external_id") @db.VarChar(500)
  externalUrl        String?            @map("external_url")
  externalName       String?            @map("external_name")
  availabilityStatus AvailabilityStatus @default(UNKNOWN) @map("availability_status")
  metadata           Json               @default("{}")
  lastCheckedAt      DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, entityType, externalId])
  @@index([entityType, entityId])
  @@index([sourceId, entityType])
  @@index([lastCheckedAt])
  @@map("external_entities")
}

model SourceSnapshot {
  id            String    @id @default(uuid()) @db.Uuid
  sourceId      String    @map("source_id") @db.Uuid
  sourceUrl     String?   @map("source_url")
  externalId    String?   @map("external_id") @db.VarChar(500)
  contentType   String?   @map("content_type") @db.VarChar(120)
  httpStatus    Int?      @map("http_status") @db.SmallInt
  rawPayload    Json?     @map("raw_payload")
  rawText       String?   @map("raw_text") @db.Text
  contentHash   String?   @map("content_hash") @db.VarChar(128)
  parserVersion String?   @map("parser_version") @db.VarChar(80)
  fetchedAt     DateTime  @map("fetched_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  source DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  facts  EntityFact[]

  @@index([contentHash])
  @@index([sourceId, externalId])
  @@index([fetchedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("source_snapshots")
}

model EntityFact {
  id               String           @id @default(uuid()) @db.Uuid
  entityType       EntityType       @map("entity_type")
  entityId         String           @map("entity_id") @db.Uuid
  fieldName        String           @map("field_name") @db.VarChar(120)
  valueJson        Json             @map("value_json")
  normalizedValue  String?          @map("normalized_value")
  sourceId         String?          @map("source_id") @db.Uuid
  snapshotId       String?          @map("snapshot_id") @db.Uuid
  extractionMethod ExtractionMethod @map("extraction_method")
  confidence       Decimal?         @db.Decimal(5, 4)
  isVerified       Boolean          @default(false) @map("is_verified")
  isSelected       Boolean          @default(false) @map("is_selected")
  observedAt       DateTime         @map("observed_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  source   DataSource?     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  snapshot SourceSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, fieldName])
  @@index([sourceId])
  @@index([snapshotId])
  @@index([isSelected])
  @@index([isVerified])
  @@map("entity_facts")
}

model IngestionJob {
  id              String           @id @default(uuid()) @db.Uuid
  requestedById   String?          @map("requested_by") @db.Uuid
  sourceId        String?          @map("source_id") @db.Uuid
  jobType         IngestionJobType @map("job_type")
  status          JobStatus        @default(PENDING)
  sourceUrl       String?          @map("source_url")
  input           Json             @default("{}")
  totalItems      Int              @default(0) @map("total_items")
  processedItems  Int              @default(0) @map("processed_items")
  successfulItems Int              @default(0) @map("successful_items")
  failedItems     Int              @default(0) @map("failed_items")
  errorMessage    String?          @map("error_message") @db.Text
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestedBy Profile?        @relation("IngestionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  source      DataSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items       IngestionItem[]

  @@index([status])
  @@index([jobType])
  @@index([requestedById, createdAt(sort: Desc)])
  @@index([sourceId, createdAt(sort: Desc)])
  @@map("ingestion_jobs")
}

model IngestionItem {
  id                String              @id @default(uuid()) @db.Uuid
  jobId             String              @map("job_id") @db.Uuid
  sourcePosition    Int?                @map("source_position")
  sourceTimestampMs Int?                @map("source_timestamp_ms")
  rawTitle          String?             @map("raw_title") @db.Text
  rawArtist         String?             @map("raw_artist") @db.Text
  rawData           Json                @default("{}") @map("raw_data")
  matchedTrackId    String?             @map("matched_track_id") @db.Uuid
  status            IngestionItemStatus @default(PENDING)
  matchConfidence   Decimal?            @map("match_confidence") @db.Decimal(5, 4)
  errorMessage      String?             @map("error_message") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  job          IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchedTrack Track?       @relation(fields: [matchedTrackId], references: [id], onDelete: SetNull)

  @@index([jobId, status])
  @@index([matchedTrackId])
  @@index([rawTitle])
  @@index([sourceTimestampMs])
  @@map("ingestion_items")
}

model EnrichmentJob {
  id             String            @id @default(uuid()) @db.Uuid
  entityType     EntityType        @map("entity_type")
  entityId       String            @map("entity_id") @db.Uuid
  jobType        EnrichmentJobType @map("job_type")
  status         JobStatus         @default(PENDING)
  provider       String?           @db.VarChar(120)
  modelName      String?           @map("model_name") @db.VarChar(160)
  processVersion String?           @map("process_version") @db.VarChar(80)
  input          Json              @default("{}")
  output         Json              @default("{}")
  confidence     Decimal?          @db.Decimal(5, 4)
  tokensUsed     Int?              @map("tokens_used")
  estimatedCost  Decimal?          @map("estimated_cost") @db.Decimal(12, 6)
  errorMessage   String?           @map("error_message") @db.Text
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt(sort: Desc)])
  @@map("enrichment_jobs")
}

model LegacyUserTrack {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  trackId      String          @map("track_id") @db.Uuid
  status       UserTrackStatus @default(LIBRARY)
  rating       Int?            @db.SmallInt
  energy       Int?            @db.SmallInt
  familiarity  Int?            @db.SmallInt
  notes        String?         @db.Text
  customBpm    Decimal?        @map("custom_bpm") @db.Decimal(7, 3)
  customKey    String?         @map("custom_key") @db.VarChar(20)
  isFavorite   Boolean         @default(false) @map("is_favorite")
  playCount    Int             @default(0) @map("play_count")
  dateAdded    DateTime        @default(now()) @map("date_added") @db.Timestamptz(6)
  lastPlayedAt DateTime?       @map("last_played_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track              @relation(fields: [trackId], references: [id], onDelete: Restrict)
  tags  LegacyUserTrackTag[]

  @@unique([userId, trackId])
  @@index([userId, dateAdded(sort: Desc)])
  @@index([userId, isFavorite])
  @@index([userId, status])
  @@index([trackId])
  @@map("legacy_user_tracks")
}

model LegacyProfileTag {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(80)
  normalizedName String   @map("normalized_name") @db.VarChar(80)
  color          String?  @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTracks LegacyUserTrackTag[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@index([normalizedName])
  @@map("legacy_profile_tags")
}

model LegacyUserTrackTag {
  userTrackId String @map("user_track_id") @db.Uuid
  tagId       String @map("tag_id") @db.Uuid

  userTrack LegacyUserTrack  @relation(fields: [userTrackId], references: [id], onDelete: Cascade)
  tag       LegacyProfileTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userTrackId, tagId])
  @@map("legacy_user_track_tags")
}

model LegacyProfilePlaylist {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  name         String       @db.VarChar(255)
  slug         String?      @db.VarChar(255)
  description  String?      @db.Text
  playlistType PlaylistType @map("playlist_type")
  visibility   Visibility   @default(PRIVATE)
  artworkUrl   String?      @map("artwork_url")
  sourceUrl    String?      @map("source_url")
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks LegacyPlaylistTrack[]

  @@unique([userId, slug])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([visibility])
  @@index([playlistType])
  @@map("legacy_profile_playlists")
}

model LegacyPlaylistTrack {
  id                String   @id @default(uuid()) @db.Uuid
  playlistId        String   @map("playlist_id") @db.Uuid
  trackId           String   @map("track_id") @db.Uuid
  position          Int
  addedById         String?  @map("added_by") @db.Uuid
  notes             String?  @db.Text
  transitionNotes   String?  @map("transition_notes") @db.Text
  sourceTimestampMs Int?     @map("source_timestamp_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  playlist LegacyProfilePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track                 @relation(fields: [trackId], references: [id], onDelete: Restrict)
  addedBy  Profile?              @relation("LegacyPlaylistTrackAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([playlistId, position])
  @@index([playlistId, position])
  @@index([trackId])
  @@index([addedById])
  @@map("legacy_playlist_tracks")
}
