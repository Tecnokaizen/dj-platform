generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum ArtistType {
  PERSON
  GROUP
  PROJECT
  ORCHESTRA
  COLLECTIVE
  UNKNOWN
}

enum ArtistRole {
  PRIMARY
  FEATURED
  REMIXER
  PRODUCER
  COMPOSER
  VOCALIST
  DJ_MIXER
  OTHER
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
  COMPILATION
  DJ_MIX
  SOUNDTRACK
  LIVE
  OTHER
}

enum AssignmentMethod {
  SOURCE
  AI
  AUDIO_ANALYSIS
  MANUAL
  CONSENSUS
}

enum SourceType {
  API
  WEB
  FILE
  AI
  MANUAL
  INTERNAL
}

enum EntityType {
  ARTIST
  TRACK
  RELEASE
  LABEL
  GENRE
  PLAYLIST
  DJ_SET
}

enum AvailabilityStatus {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
  REGION_RESTRICTED
  REMOVED
  PRIVATE
}

enum ExtractionMethod {
  API_RESPONSE
  HTML_PARSER
  STRUCTURED_DATA
  METADATA
  AUDIO_ANALYSIS
  AI_EXTRACTION
  AI_INFERENCE
  MANUAL
  DERIVED
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLED
}

enum IngestionJobType {
  TRACKLIST_URL
  TRACKLIST_TEXT
  PLAYLIST_URL
  CHANNEL_SCAN
  SOURCE_SYNC
  FILE_IMPORT
  MANUAL_BATCH
}

enum IngestionItemStatus {
  PENDING
  PARSED
  MATCHED
  CREATED
  NEEDS_REVIEW
  SKIPPED
  FAILED
}

enum EnrichmentJobType {
  METADATA_ENRICHMENT
  TRACK_MATCHING
  GENRE_CLASSIFICATION
  BPM_ANALYSIS
  KEY_ANALYSIS
  MOOD_CLASSIFICATION
  ENERGY_CLASSIFICATION
  ARTIST_RESOLUTION
  DUPLICATE_DETECTION
  SOURCE_DISCOVERY
  PLAYLIST_ANALYSIS
  TRANSITION_RECOMMENDATION
}

enum UserTrackStatus {
  LIBRARY
  WISHLIST
  ARCHIVED
  REJECTED
}

enum PlaylistType {
  MANUAL
  IMPORTED
  SMART
  AI_GENERATED
  CRATE
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Profile {
  id                String           @id @db.Uuid
  username          String?          @unique @db.VarChar(50)
  displayName       String?          @map("display_name") @db.VarChar(120)
  djName            String?          @map("dj_name") @db.VarChar(120)
  avatarUrl         String?          @map("avatar_url")
  bio               String?          @db.Text
  countryCode       String?          @map("country_code") @db.Char(2)
  preferredLanguage String           @default("es") @map("preferred_language") @db.VarChar(10)
  experienceLevel   ExperienceLevel? @map("experience_level")
  isAdmin           Boolean          @default(false) @map("is_admin")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  userTracks          UserTrack[]
  tags                Tag[]
  playlists           Playlist[]
  ingestionJobs       IngestionJob[]  @relation("IngestionRequestedBy")
  playlistTracksAdded PlaylistTrack[] @relation("PlaylistTrackAddedBy")

  @@map("profiles")
}

model Artist {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(255)
  normalizedName      String     @map("normalized_name") @db.VarChar(255)
  slug                String     @unique @db.VarChar(255)
  artistType          ArtistType @default(PERSON) @map("artist_type")
  countryCode         String?    @map("country_code") @db.Char(2)
  biography           String?    @db.Text
  imageUrl            String?    @map("image_url")
  canonicalConfidence Decimal?   @map("canonical_confidence") @db.Decimal(5, 4)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  trackArtists TrackArtist[]

  @@index([normalizedName])
  @@map("artists")
}

model Track {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String    @db.VarChar(500)
  normalizedTitle     String    @map("normalized_title") @db.VarChar(500)
  version             String?   @db.VarChar(255)
  durationMs          Int?      @map("duration_ms")
  bpm                 Decimal?  @db.Decimal(7, 3)
  musicalKey          String?   @map("musical_key") @db.VarChar(20)
  camelotKey          String?   @map("camelot_key") @db.VarChar(4)
  isrc                String?   @db.VarChar(20)
  releaseDate         DateTime? @map("release_date") @db.Date
  explicit            Boolean?
  artworkUrl          String?   @map("artwork_url")
  canonicalConfidence Decimal?  @map("canonical_confidence") @db.Decimal(5, 4)
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  artists        TrackArtist[]
  genres         TrackGenre[]
  releases       ReleaseTrack[]
  userTracks     UserTrack[]
  playlistTracks PlaylistTrack[]
  ingestionItems IngestionItem[]

  @@index([normalizedTitle])
  @@index([isrc])
  @@index([bpm])
  @@index([camelotKey])
  @@map("tracks")
}

model TrackArtist {
  trackId      String     @map("track_id") @db.Uuid
  artistId     String     @map("artist_id") @db.Uuid
  role         ArtistRole
  position     Int        @default(0) @db.SmallInt
  creditedName String?    @map("credited_name") @db.VarChar(255)

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([trackId, artistId, role])
  @@index([artistId])
  @@index([trackId, position])
  @@map("track_artists")
}

model Genre {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @map("normalized_name") @db.VarChar(120)
  slug           String   @unique @db.VarChar(150)
  parentId       String?  @map("parent_id") @db.Uuid
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Genre?       @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Genre[]      @relation("GenreHierarchy")
  tracks   TrackGenre[]

  @@index([normalizedName])
  @@index([parentId])
  @@map("genres")
}

model TrackGenre {
  trackId          String           @map("track_id") @db.Uuid
  genreId          String           @map("genre_id") @db.Uuid
  isPrimary        Boolean          @default(false) @map("is_primary")
  confidence       Decimal?         @db.Decimal(5, 4)
  assignmentMethod AssignmentMethod @map("assignment_method")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([trackId, genreId])
  @@index([genreId])
  @@index([trackId, isPrimary])
  @@map("track_genres")
}

model Label {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  normalizedName String   @map("normalized_name") @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  countryCode    String?  @map("country_code") @db.Char(2)
  websiteUrl     String?  @map("website_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  releases Release[]

  @@index([normalizedName])
  @@map("labels")
}

model Release {
  id              String      @id @default(uuid()) @db.Uuid
  title           String      @db.VarChar(500)
  normalizedTitle String      @map("normalized_title") @db.VarChar(500)
  releaseType     ReleaseType @map("release_type")
  labelId         String?     @map("label_id") @db.Uuid
  catalogNumber   String?     @map("catalog_number") @db.VarChar(100)
  releaseDate     DateTime?   @map("release_date") @db.Date
  artworkUrl      String?     @map("artwork_url")
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  label  Label?         @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tracks ReleaseTrack[]

  @@index([normalizedTitle])
  @@index([labelId])
  @@index([releaseDate])
  @@index([catalogNumber])
  @@map("releases")
}

model ReleaseTrack {
  releaseId   String @map("release_id") @db.Uuid
  trackId     String @map("track_id") @db.Uuid
  discNumber  Int    @default(1) @map("disc_number") @db.SmallInt
  trackNumber Int?   @map("track_number") @db.SmallInt
  position    Int

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([releaseId, position])
  @@unique([releaseId, discNumber, trackNumber])
  @@index([trackId])
  @@map("release_tracks")
}

model DataSource {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(80)
  name        String     @db.VarChar(160)
  sourceType  SourceType @map("source_type")
  baseUrl     String?    @map("base_url")
  isActive    Boolean    @default(true) @map("is_active")
  trustWeight Decimal    @default(0.5000) @map("trust_weight") @db.Decimal(5, 4)
  config      Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalEntities ExternalEntity[]
  snapshots        SourceSnapshot[]
  facts            EntityFact[]
  ingestionJobs    IngestionJob[]

  @@map("data_sources")
}

model ExternalEntity {
  id                 String             @id @default(uuid()) @db.Uuid
  sourceId           String             @map("source_id") @db.Uuid
  entityType         EntityType         @map("entity_type")
  entityId           String             @map("entity_id") @db.Uuid
  externalId         String?            @map("external_id") @db.VarChar(500)
  externalUrl        String?            @map("external_url")
  externalName       String?            @map("external_name")
  availabilityStatus AvailabilityStatus @default(UNKNOWN) @map("availability_status")
  metadata           Json               @default("{}")
  lastCheckedAt      DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, entityType, externalId])
  @@index([entityType, entityId])
  @@index([sourceId, entityType])
  @@index([lastCheckedAt])
  @@map("external_entities")
}

model SourceSnapshot {
  id            String    @id @default(uuid()) @db.Uuid
  sourceId      String    @map("source_id") @db.Uuid
  sourceUrl     String?   @map("source_url")
  externalId    String?   @map("external_id") @db.VarChar(500)
  contentType   String?   @map("content_type") @db.VarChar(120)
  httpStatus    Int?      @map("http_status") @db.SmallInt
  rawPayload    Json?     @map("raw_payload")
  rawText       String?   @map("raw_text") @db.Text
  contentHash   String?   @map("content_hash") @db.VarChar(128)
  parserVersion String?   @map("parser_version") @db.VarChar(80)
  fetchedAt     DateTime  @map("fetched_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  source DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  facts  EntityFact[]

  @@index([contentHash])
  @@index([sourceId, externalId])
  @@index([fetchedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("source_snapshots")
}

model EntityFact {
  id               String           @id @default(uuid()) @db.Uuid
  entityType       EntityType       @map("entity_type")
  entityId         String           @map("entity_id") @db.Uuid
  fieldName        String           @map("field_name") @db.VarChar(120)
  valueJson        Json             @map("value_json")
  normalizedValue  String?          @map("normalized_value")
  sourceId         String?          @map("source_id") @db.Uuid
  snapshotId       String?          @map("snapshot_id") @db.Uuid
  extractionMethod ExtractionMethod @map("extraction_method")
  confidence       Decimal?         @db.Decimal(5, 4)
  isVerified       Boolean          @default(false) @map("is_verified")
  isSelected       Boolean          @default(false) @map("is_selected")
  observedAt       DateTime         @map("observed_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  source   DataSource?     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  snapshot SourceSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, fieldName])
  @@index([sourceId])
  @@index([snapshotId])
  @@index([isSelected])
  @@index([isVerified])
  @@map("entity_facts")
}

model IngestionJob {
  id              String           @id @default(uuid()) @db.Uuid
  requestedById   String?          @map("requested_by") @db.Uuid
  sourceId        String?          @map("source_id") @db.Uuid
  jobType         IngestionJobType @map("job_type")
  status          JobStatus        @default(PENDING)
  sourceUrl       String?          @map("source_url")
  input           Json             @default("{}")
  totalItems      Int              @default(0) @map("total_items")
  processedItems  Int              @default(0) @map("processed_items")
  successfulItems Int              @default(0) @map("successful_items")
  failedItems     Int              @default(0) @map("failed_items")
  errorMessage    String?          @map("error_message") @db.Text
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestedBy Profile?        @relation("IngestionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  source      DataSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items       IngestionItem[]

  @@index([status])
  @@index([jobType])
  @@index([requestedById, createdAt(sort: Desc)])
  @@index([sourceId, createdAt(sort: Desc)])
  @@map("ingestion_jobs")
}

model IngestionItem {
  id                String              @id @default(uuid()) @db.Uuid
  jobId             String              @map("job_id") @db.Uuid
  sourcePosition    Int?                @map("source_position")
  sourceTimestampMs Int?                @map("source_timestamp_ms")
  rawTitle          String?             @map("raw_title") @db.Text
  rawArtist         String?             @map("raw_artist") @db.Text
  rawData           Json                @default("{}") @map("raw_data")
  matchedTrackId    String?             @map("matched_track_id") @db.Uuid
  status            IngestionItemStatus @default(PENDING)
  matchConfidence   Decimal?            @map("match_confidence") @db.Decimal(5, 4)
  errorMessage      String?             @map("error_message") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  job          IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchedTrack Track?       @relation(fields: [matchedTrackId], references: [id], onDelete: SetNull)

  @@index([jobId, status])
  @@index([matchedTrackId])
  @@index([rawTitle])
  @@index([sourceTimestampMs])
  @@map("ingestion_items")
}

model EnrichmentJob {
  id             String            @id @default(uuid()) @db.Uuid
  entityType     EntityType        @map("entity_type")
  entityId       String            @map("entity_id") @db.Uuid
  jobType        EnrichmentJobType @map("job_type")
  status         JobStatus         @default(PENDING)
  provider       String?           @db.VarChar(120)
  modelName      String?           @map("model_name") @db.VarChar(160)
  processVersion String?           @map("process_version") @db.VarChar(80)
  input          Json              @default("{}")
  output         Json              @default("{}")
  confidence     Decimal?          @db.Decimal(5, 4)
  tokensUsed     Int?              @map("tokens_used")
  estimatedCost  Decimal?          @map("estimated_cost") @db.Decimal(12, 6)
  errorMessage   String?           @map("error_message") @db.Text
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt(sort: Desc)])
  @@map("enrichment_jobs")
}

model UserTrack {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  trackId      String          @map("track_id") @db.Uuid
  status       UserTrackStatus @default(LIBRARY)
  rating       Int?            @db.SmallInt
  energy       Int?            @db.SmallInt
  familiarity  Int?            @db.SmallInt
  notes        String?         @db.Text
  customBpm    Decimal?        @map("custom_bpm") @db.Decimal(7, 3)
  customKey    String?         @map("custom_key") @db.VarChar(20)
  isFavorite   Boolean         @default(false) @map("is_favorite")
  playCount    Int             @default(0) @map("play_count")
  dateAdded    DateTime        @default(now()) @map("date_added") @db.Timestamptz(6)
  lastPlayedAt DateTime?       @map("last_played_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track          @relation(fields: [trackId], references: [id], onDelete: Restrict)
  tags  UserTrackTag[]

  @@unique([userId, trackId])
  @@index([userId, dateAdded(sort: Desc)])
  @@index([userId, isFavorite])
  @@index([userId, status])
  @@index([trackId])
  @@map("user_tracks")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(80)
  normalizedName String   @map("normalized_name") @db.VarChar(80)
  color          String?  @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTracks UserTrackTag[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@index([normalizedName])
  @@map("tags")
}

model UserTrackTag {
  userTrackId String @map("user_track_id") @db.Uuid
  tagId       String @map("tag_id") @db.Uuid

  userTrack UserTrack @relation(fields: [userTrackId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userTrackId, tagId])
  @@map("user_track_tags")
}

model Playlist {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  name         String       @db.VarChar(255)
  slug         String?      @db.VarChar(255)
  description  String?      @db.Text
  playlistType PlaylistType @map("playlist_type")
  visibility   Visibility   @default(PRIVATE)
  artworkUrl   String?      @map("artwork_url")
  sourceUrl    String?      @map("source_url")
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@unique([userId, slug])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([visibility])
  @@index([playlistType])
  @@map("playlists")
}

model PlaylistTrack {
  id                String   @id @default(uuid()) @db.Uuid
  playlistId        String   @map("playlist_id") @db.Uuid
  trackId           String   @map("track_id") @db.Uuid
  position          Int
  addedById         String?  @map("added_by") @db.Uuid
  notes             String?  @db.Text
  transitionNotes   String?  @map("transition_notes") @db.Text
  sourceTimestampMs Int?     @map("source_timestamp_ms")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  addedBy  Profile? @relation("PlaylistTrackAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([playlistId, position])
  @@index([playlistId, position])
  @@index([trackId])
  @@index([addedById])
  @@map("playlist_tracks")
}
