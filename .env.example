# Application runtime (trusted server only)
DATABASE_URL="postgresql://app_runtime:change-me@localhost:5432/dj_platform?schema=public"

# Public application configuration (embedded in the staging image at build time)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-anon-key"

# Release migrator only. Never inject this into the web runtime.
POSTGRES_ADMIN_URL="postgresql://supabase_admin:change-me@localhost:5432/dj_platform"
MIGRATION_ROLE_NAME="platform_migration"
MIGRATION_ROLE_PASSWORD="replace-at-deploy-time"
APP_RUNTIME_ROLE_NAME="app_runtime"
APP_RUNTIME_ROLE_PASSWORD="replace-at-deploy-time"
MIGRATION_DATABASE_URL="postgresql://platform_migration:change-me@localhost:5432/dj_platform?schema=public"
SUPABASE_DB_URL="postgresql://platform_migration:change-me@localhost:5432/dj_platform"
SUPABASE_CLI_VERSION="2.109.1"

# Backup job only. Keep credentials in Coolify plus an external operator vault.
BACKUP_DATABASE_URL="postgresql://backup-operator:change-me@localhost:5432/dj_platform"
BACKUP_HOST="platform-staging"
RESTIC_REPOSITORY="s3:https://s3.example.com/platform-staging"
RESTIC_PASSWORD="replace-at-deploy-time"
AWS_ACCESS_KEY_ID="replace-at-deploy-time"
AWS_SECRET_ACCESS_KEY="replace-at-deploy-time"
AWS_DEFAULT_REGION="us-east-1"
