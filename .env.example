# Application runtime (trusted server only)
DATABASE_URL="postgresql://app_runtime:change-me@localhost:5432/dj_platform?schema=public"

# Public application configuration (embedded in the staging image at build time)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-local-anon-key"

# Release migrator only. Never inject this into the web runtime.
MIGRATION_DATABASE_URL="postgresql://migration:change-me@localhost:5432/dj_platform?schema=public"
SUPABASE_DB_URL="postgresql://migration:change-me@localhost:5432/dj_platform"
